# Copy to .env.local and add your own key from Google AI Studio. Never commit .env.local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: store KinCard data in Databricks instead of the local demo database.
# Leave these blank to keep using the local database. Never commit real values.
# Host looks like dbc-xxxx.cloud.databricks.com. Find the warehouse ID under
# SQL Warehouses > your warehouse > Connection details.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
# Full table name. KinCard creates it if it does not exist.
DATABRICKS_TABLE=workspace.default.kincard_households
